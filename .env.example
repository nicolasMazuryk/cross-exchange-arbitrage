# ArbiNet env template — committed, redacted. Discoverability only.
#
# The REAL dev env is the SOPS-encrypted single source of truth at
# config/secrets/dev.env.sops.yaml (same age recipient as the prod vault).
# `npm run docker:dev:up` decrypts it to the gitignored .env before compose runs
# (needs SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt). Edit secrets via
# `npm run docker:dev:secrets` (opens `sops`). Do NOT hand-edit .env — it is
# generated and overwritten on every `docker:dev:up`.
#
# Vars sourced from src/utils/config.ts + spec 04 §Secrets.

# --- App runtime ---
NODE_ENV=development                 # development | production
STRATEGY=funding                     # funding | spread (production config select)

# --- Exchange API credentials (per venue) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASS=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASS=
GATEIO_API_KEY=
GATEIO_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASS=

# --- ClickHouse (trader trade-state client; matches dev CH user) ---
# CH_URL / REDPANDA_BROKERS are injected per-service by docker-compose.dev.yml
# (clickhouse:8123 / redpanda:9092), not from this file.
CH_USER=arbinet
CH_PASSWORD=arbinet

# --- Object storage (cold tier / Parquet export) + infra creds ---
# S3_* double as the tfstate AWS_* creds (see infra/CLAUDE.md). HCLOUD_TOKEN and
# the GitHub PAT live here too so `source .env` serves the Terraform/Ansible flow.
S3_ACCESS_KEY=
S3_SECRET_KEY=
HCLOUD_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
