# Kamal secret resolution — values decrypted from the SOPS vault at command time.
# The host needs `sops` + the operator age key (SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt).
# Only secrets that already exist in the vault are wired, so resolution succeeds today.
VAULT=infra/ansible/inventories/production/group_vars/all/vault.sops.yml
KAMAL_REGISTRY_PASSWORD=$(sops -d --extract '["ghcr_pat"]' $VAULT)
CH_PASSWORD=$(sops -d --extract '["ch_arbinet_password"]' $VAULT)
S3_ACCESS_KEY=$(sops -d --extract '["S3_ACCESS_KEY"]' $VAULT)
S3_SECRET_KEY=$(sops -d --extract '["S3_SECRET_KEY"]' $VAULT)
