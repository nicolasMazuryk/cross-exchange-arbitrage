# {{ ansible_managed }}
# Env the Kamal-run spread-computer container mounts (task 13). This role lays
# config only — no app code, no container. The Kamal-run container is the source
# of truth for METRICS_PORT (config/deploy.yml); this file mirrors the stub's
# contract — METRICS_PORT (a port, not a host:port bind) — for parity. CH over
# loopback per spec §secrets-management. CH creds from the SOPS vault.
METRICS_PORT={{ spread_computer_metrics_port }}
REDPANDA_BROKERS={{ spread_computer_redpanda_brokers }}
CH_URL={{ spread_computer_ch_url }}
CH_USER={{ spread_computer_ch_user }}
CH_PASSWORD={{ spread_computer_ch_password }}
