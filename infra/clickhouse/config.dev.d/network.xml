<!-- Dev: listen on all interfaces so host-mapped ports (8123/9000) and the
     bridge app containers (trader → clickhouse:8123) can reach CH.
     Required because mounting this whole dir onto /etc/clickhouse-server/config.d
     SHADOWS the stock image's docker_related_config.xml (which normally sets
     listen_host 0.0.0.0) — so we re-provide it here. Dev-only; prod CH binds the
     private IP via its own config. -->
<clickhouse>
  <listen_host>0.0.0.0</listen_host>
</clickhouse>
