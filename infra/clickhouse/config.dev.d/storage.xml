<!-- Dev storage policy: single-disk only. No warm/cold tier in local dev.
     Schemas reference policy `tiered`; we redefine it here as a single-volume
     alias of the default disk so identical DDL works in dev and prod. -->
<clickhouse>
  <storage_configuration>
    <disks>
      <default>
        <path>/var/lib/clickhouse/</path>
      </default>
    </disks>
    <policies>
      <tiered>
        <volumes>
          <hot>
            <disk>default</disk>
          </hot>
        </volumes>
      </tiered>
    </policies>
  </storage_configuration>
</clickhouse>
