<!-- Dev: native ClickHouse Prometheus endpoint on :9363 (prod parity with
     infra/ansible/roles/clickhouse/templates/prometheus.xml.j2). First-party
     metrics, no exporter binary. Alloy scrapes clickhouse:9363 as job=clickhouse
     (dropping ClickHouseProfileEvents_* at the scrape edge, same as prod). This
     fragment lives in the dev override dir mounted at
     /etc/clickhouse-server/config.d (docker-compose.dev.yml). -->
<clickhouse>
  <prometheus>
    <endpoint>/metrics</endpoint>
    <port>9363</port>
    <metrics>true</metrics>
    <events>true</events>
    <asynchronous_metrics>true</asynchronous_metrics>
    <errors>true</errors>
  </prometheus>
</clickhouse>
