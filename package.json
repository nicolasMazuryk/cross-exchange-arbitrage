{
  "name": "cross-exchange-arbitrage",
  "version": "1.0.0",
  "description": "Spatial and funding-rate arbitrage across crypto exchanges",
  "main": "dist/main.js",
  "engines": {
    "node": "24.13"
  },
  "scripts": {
    "start": "ts-node src/main.ts",
    "start:trader": "node dist/trader.js",
    "start:queryapi": "node dist/queryApi.js",
    "start:spreadcomputer": "node dist/spreadComputer.js",
    "debug": "tsc && node --inspect-brk=127.0.0.1:9229 --enable-source-maps dist/main.js",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:dev:up": "sops -d --output-type dotenv config/secrets/dev.env.sops.yaml > .env.tmp && mv .env.tmp .env && docker compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f trader query-api spread-computer",
    "docker:dev:obs:verify": "bash scripts/obs-smoke.sh",
    "docker:dev:secrets": "sops config/secrets/dev.env.sops.yaml",
    "push:ecr": "bash docker/push-to-ecr.sh"
  },
  "dependencies": {
    "@clickhouse/client": "^1.12.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@pyroscope/nodejs": "^0.4.12",
    "@hyperdrive-eng/mcp-nodejs-debugger": "^0.2.2",
    "binance": "^3.5.8",
    "bitget-api": "^3.1.7",
    "bybit-api": "^4.6.2",
    "ccxt": "^4.5.54",
    "cron": "^4.3.4",
    "dotenv": "^16.4.5",
    "ioredis": "^5.8.2",
    "kafkajs": "^2.2.4",
    "okx-api": "^3.1.4",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "playwright": "^1.55.0",
    "prom-client": "^15.1.3",
    "redlock": "^5.0.0-beta.2",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/cron": "^2.0.1",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasMazuryk/cross-exchange-arbitrage.git"
  }
}
