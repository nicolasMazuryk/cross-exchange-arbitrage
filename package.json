{
  "name": "arbinet",
  "version": "1.0.0",
  "description": "Automated Spatial Crypto Arbitrage System",
  "main": "dist/main.js",
  "engines": {
    "node": "22.12"
  },
  "scripts": {
    "start": "ts-node src/main.ts",
    "dev": "ts-node-dev --respawn src/main.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "terraform": "cd terraform && terraform apply",
    "deploy": "bash docker/deploy.sh"
  },
  "dependencies": {
    "@hyperdrive-eng/mcp-nodejs-debugger": "^0.2.2",
    "binance": "^2.15.21",
    "bitget-api": "^2.3.5",
    "bybit-api": "^4.1.10",
    "ccxt": "^4.4.88",
    "cron": "^4.3.4",
    "dotenv": "^16.4.5",
    "ioredis": "^5.8.2",
    "okx-api": "^2.0.5",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "playwright": "^1.55.0",
    "redlock": "^5.0.0-beta.2",
    "ws": "^8.18.2",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/cron": "^2.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
