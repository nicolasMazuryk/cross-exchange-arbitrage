{
  "name": "arbinet",
  "version": "1.0.0",
  "description": "Automated Spatial Crypto Arbitrage System",
  "main": "dist/main.js",
  "engines": {
    "node": "22.12"
  },
  "scripts": {
    "start": "ts-node src/main.ts",
    "debug": "tsc && node --inspect-brk=127.0.0.1:9229 --enable-source-maps dist/main.js",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f trader query-api",
    "push:ecr": "bash docker/push-to-ecr.sh"
  },
  "dependencies": {
    "@hyperdrive-eng/mcp-nodejs-debugger": "^0.2.2",
    "binance": "^3.5.8",
    "bitget-api": "^3.1.7",
    "bybit-api": "^4.6.2",
    "ccxt": "^4.5.54",
    "cron": "^4.3.4",
    "dotenv": "^16.4.5",
    "ioredis": "^5.8.2",
    "okx-api": "^3.1.4",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "playwright": "^1.55.0",
    "redlock": "^5.0.0-beta.2",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/cron": "^2.0.1",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
