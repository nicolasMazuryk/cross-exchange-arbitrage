# Dev-local Grafana env — diverges from prod grafana.env.j2 (which keeps
# anonymous OFF + a vault admin password). Dev enables anonymous Admin so agents
# can curl the API without auth (GET /api/datasources, datasource health). Local
# only; never used in prod. Documented divergence in OBSERVABILITY.md.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
GF_SERVER_HTTP_PORT=3000
# Pyroscope datasource is core in Grafana 13, but install the app plugin too so
# the profiles UI renders identically to prod.
GF_INSTALL_PLUGINS=grafana-pyroscope-app
