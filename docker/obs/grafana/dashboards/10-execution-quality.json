{
  "uid": "arbinet-exec-quality",
  "title": "10 \u00b7 Execution Quality",
  "tags": [
    "arbinet"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Fill rate (filled/total)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(order_fills_total{status=\"filled\"}[10m])) / clamp_min(sum(rate(order_fills_total[10m])),1)",
          "legendFormat": "fill rate",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Slippage p95 (bps) \u2014 warn >20",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
