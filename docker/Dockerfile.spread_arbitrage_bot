# arm64
FROM --platform=linux/arm64 node:22.12-slim
# x86_64
# FROM --platform=linux/amd64 node:22.12-slim

WORKDIR /app

COPY ../config/spread.production.yaml ./config/

COPY ../package*.json ./
COPY ../tsconfig.json ./

COPY ../src/ ./src/

RUN npm install
# Install Playwright browsers (required for funding data fetching)
RUN npx playwright install --with-deps chromium

RUN npm run build

ENV NODE_ENV=production
ENV STRATEGY=spread

# Exchange credentials are not baked into the image: pass them at runtime
# (docker run --env-file .env, or Kamal secrets). See .env.example.

EXPOSE 3000

# main accounts for all exchanges

CMD ["node", "dist/main.js"]
